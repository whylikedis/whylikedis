{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package-lock.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#check"],
      "inputs": [
        "app/**",
        "components/**",
        "lib/**",
        "styles/**",
        "public/**",
        "export.py",
        "check.mjs",
        "next.config.ts",
        "postcss.config.mjs",
        "components.json",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/facts/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/tools/factcheck.py"
      ],
      "outputs": [".next/**", "!.next/cache/**", "data/**"],
      "env": ["SITE_PREVIEW"]
    },
    "//#check": {
      "inputs": ["facts/**", "tools/**"],
      "outputs": []
    },
    "//#lint:md": {
      "inputs": ["**/*.md", ".markdownlint-cli2.jsonc"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
