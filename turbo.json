{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package-lock.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "build.py",
        "vercel.json",
        "assets/**",
        "package.json",
        "$TURBO_ROOT$/facts/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/tools/factcheck.py"
      ],
      "outputs": ["dist/**"]
    },
    "//#check": {
      "inputs": ["facts/**", "tools/**"],
      "outputs": []
    },
    "//#lint:md": {
      "inputs": ["**/*.md", ".markdownlint-cli2.jsonc"],
      "outputs": []
    }
  }
}
