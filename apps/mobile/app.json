{
  "expo": {
    "name": "WhyLikeDIs",
    "slug": "whylikedis",
    "scheme": "whylikedis",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f4ee",
    "ios": {
      "bundleIdentifier": "com.whylikedis.app",
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.whylikedis.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f4ee",
          "dark": {
            "backgroundColor": "#191814"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
