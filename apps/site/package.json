{
  "name": "@whylikedis/site",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "The site: a Next.js projection of the fact base and the docs.",
  "scripts": {
    "export": "python3 export.py",
    "build": "python3 export.py && next build && node check.mjs",
    "start": "next start -p 4173",
    "preview": "python3 export.py && SITE_PREVIEW=1 next dev -p 4173",
    "typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test 'lib/**/*.test.ts'",
    "e2e:build": "node e2e/build.mjs",
    "e2e": "playwright test --project=ux",
    "e2e:docker": "bash e2e/docker.sh",
    "e2e:docker:update": "bash e2e/docker.sh --project=visual --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@whylikedis/content": "*",
    "@whylikedis/games": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "1.65.1",
    "typescript": "^7.0.2"
  }
}
